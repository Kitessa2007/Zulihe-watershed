
# =============================================================================
# ZULIHE WATERSHED: BAYESIAN LEREI-X RESILIENCE MODELLING
# Multi-year analysis: 1995, 2010, 2025
# =============================================================================
#
# Bayesian latent-factor modelling of pre-computed resistance (R),
# recovery (C), and adaptability (A).
#
# Study area: Zulihe Watershed, western Loess Plateau, China
# Growing season: May-September
# Spatial resolution: 10 m
#
# INPUT:
#   One three-band GeoTIFF for each year:
#   Band 1 = Resistance (R)
#   Band 2 = Recovery (C)
#   Band 3 = Adaptability (A)
#
# OUTPUT:
#   - Annual LEREI-X GeoTIFFs (common 0-1 scale)
#   - CmdStan chain CSV files
#   - Posterior draws and fitted model (RDS)
#   - Bayesian parameter and convergence summaries (CSV)
#   - LightGBM model and feature importance
#   - Spatial-block cross-validation results (CSV)
#   - Annual LEREI-X statistics (CSV)
#   - Reproducibility metadata and R session information
#
# IMPORTANT:
#   This script estimates LEREI-X from pre-computed R, C, and A rasters.
#   It does not calculate R, C, and A from satellite imagery.
#   All input rasters must contain real Zulihe-derived data.
# =============================================================================


# =============================================================================
# 1. LOAD REQUIRED PACKAGES
# =============================================================================

required_packages <- c(
  "terra",
  "sf",
  "dplyr",
  "readr",
  "cmdstanr",
  "posterior",
  "lightgbm"
)

missing_packages <- required_packages[
  !vapply(
    required_packages,
    requireNamespace,
    quietly = TRUE,
    FUN.VALUE = logical(1)
  )
]

if (length(missing_packages) > 0) {
  stop(
    "Install these R packages first: ",
    paste(missing_packages, collapse = ", ")
  )
}

library(terra)
library(sf)
library(dplyr)
library(readr)
library(cmdstanr)
library(posterior)
library(lightgbm)


# =============================================================================
# 2. PROJECT SETTINGS
# =============================================================================

YEARS <- c(1995, 2010, 2025)

INPUT_FILES <- c(
  "1995" = "Zulihe_Components/components_1995.tif",
  "2010" = "Zulihe_Components/components_2010.tif",
  "2025" = "Zulihe_Components/components_2025.tif"
)

OUTPUT_DIR <- "Zulihe_LEREI_X_Output"

STUDY_AREA <- "Zulihe Watershed, Gansu-Ningxia, China"

ROI_ASSET <- "ee-kitessa2007/assets/zlh"

SEASON <- "May-September"

EXPECTED_RESOLUTION_M <- 10

N_SAMPLES_PER_YEAR <- 1000

BAYESIAN_CHAINS <- 4

BAYESIAN_WARMUP <- 1000

BAYESIAN_DRAWS <- 1000

N_CV_FOLDS <- 5

SPATIAL_BLOCK_SIZE_M <- 5000

RANDOM_STATE <- 42

set.seed(RANDOM_STATE)


# =============================================================================
# 3. CHECK CMDSTAN INSTALLATION
# =============================================================================

if (is.null(cmdstanr::cmdstan_version(error_on_NA = FALSE))) {
  stop(
    "CmdStan is not installed. Install CmdStan using ",
    "cmdstanr::install_cmdstan() and run this script again."
  )
}


# =============================================================================
# 4. CREATE OUTPUT DIRECTORIES
# =============================================================================

output_folders <- c(
  "rasters",
  "traces",
  "summary",
  "models",
  "scripts"
)

for (folder in output_folders) {
  dir.create(
    file.path(OUTPUT_DIR, folder),
    recursive = TRUE,
    showWarnings = FALSE
  )
}


# =============================================================================
# 5. VALIDATE INPUT RASTERS
# =============================================================================

raster_list <- list()

for (year in YEARS) {

  raster_path <- INPUT_FILES[as.character(year)]

  if (!file.exists(raster_path)) {
    stop(
      "Missing input raster for ", year, ": ", raster_path
    )
  }

  r <- terra::rast(raster_path)

  if (terra::nlyr(r) != 3) {
    stop(
      "The ", year,
      " raster must contain exactly three bands: R, C, and A."
    )
  }

  if (is.na(terra::crs(r)) || terra::crs(r) == "") {
    stop("The raster for ", year, " has no defined CRS.")
  }

  if (any(abs(terra::res(r) - EXPECTED_RESOLUTION_M) > 0.01)) {
    stop(
      "The raster for ", year,
      " does not have the expected 10 m resolution."
    )
  }

  names(r) <- c("R", "C", "A")

  raster_list[[as.character(year)]] <- r

  cat(
    "\nValidated year:", year,
    "\nRows:", terra::nrow(r),
    "\nColumns:", terra::ncol(r),
    "\nResolution:", paste(terra::res(r), collapse = ", "),
    "\nCRS:", terra::crs(r),
    "\n"
  )
}


# Confirm that all annual rasters use the same grid geometry.

reference_raster <- raster_list[["1995"]]

for (year in c(2010, 2025)) {

  current_raster <- raster_list[[as.character(year)]]

  same_geometry <- terra::compareGeom(
    reference_raster,
    current_raster,
    stopOnError = FALSE
  )

  if (!same_geometry) {
    stop(
      "Raster geometry mismatch for ", year,
      ". Align CRS, extent, resolution, and origin before modelling."
    )
  }
}


# Spatial blocking in metres requires a projected CRS.

if (sf::st_is_longlat(sf::st_crs(terra::crs(reference_raster)))) {
  stop(
    "The input rasters use a geographic CRS. ",
    "Reproject the rasters to an appropriate projected CRS ",
    "with metre units before using the 5,000 m spatial blocks."
  )
}


# =============================================================================
# 6. EXTRACT VALID PIXEL SAMPLES
# =============================================================================

extract_samples <- function(
    raster,
    year,
    n_samples = 1000,
    random_state = 42
) {

  set.seed(random_state)

  # Randomly sample points from pixels with complete R, C, and A values.
  sampled_points <- terra::spatSample(
    raster,
    size = n_samples,
    method = "random",
    na.rm = TRUE,
    as.points = TRUE,
    values = TRUE
  )

  if (is.null(sampled_points) || nrow(sampled_points) == 0) {
    stop("No valid sampled pixels for year ", year)
  }

  sampled_values <- as.data.frame(
    terra::values(sampled_points)
  )

  sampled_coordinates <- terra::crds(
    sampled_points,
    df = TRUE
  )

  # Use the three raster values and their spatial coordinates.
  if (ncol(sampled_values) < 3) {
    stop(
      "Could not extract all three component values for year ",
      year
    )
  }

  names(sampled_values)[1:3] <- c("R", "C", "A")

  sample_data <- data.frame(
    year = year,
    R = sampled_values$R,
    C = sampled_values$C,
    A = sampled_values$A,
    x = sampled_coordinates[, 1],
    y = sampled_coordinates[, 2]
  )

  sample_data <- sample_data[
    complete.cases(sample_data) &
      apply(
        sample_data[, c("R", "C", "A", "x", "y")],
        1,
        function(z) all(is.finite(z))
      ),
  ]

  if (nrow(sample_data) < 100) {
    stop(
      "Fewer than 100 valid samples were obtained for year ",
      year,
      ". Check the input raster and NoData values."
    )
  }

  sample_data
}


# =============================================================================
# 7. POOL SAMPLES FROM ALL YEARS
# =============================================================================

sample_list <- list()

for (year in YEARS) {

  cat("\nSampling Zulihe component data for:", year, "\n")

  sample_list[[as.character(year)]] <- extract_samples(
    raster = raster_list[[as.character(year)]],
    year = year,
    n_samples = N_SAMPLES_PER_YEAR,
    random_state = RANDOM_STATE + year
  )
}

sample_df <- dplyr::bind_rows(sample_list)

readr::write_csv(
  sample_df,
  file.path(
    OUTPUT_DIR,
    "summary",
    "pooled_component_samples.csv"
  )
)

cat(
  "\nTotal pooled samples:",
  nrow(sample_df),
  "\n"
)


# =============================================================================
# 8. COMMON COMPONENT STANDARDISATION
# =============================================================================

component_names <- c("R", "C", "A")

component_means <- vapply(
  sample_df[, component_names],
  mean,
  numeric(1)
)

component_sds <- vapply(
  sample_df[, component_names],
  sd,
  numeric(1)
)

if (
  any(!is.finite(component_sds)) ||
  any(component_sds < 1e-10)
) {
  stop("One or more components have zero or near-zero variance.")
}

X <- as.matrix(
  sample_df[, component_names]
)

Xz <- scale(
  X,
  center = component_means,
  scale = component_sds
)

storage.mode(Xz) <- "double"

colnames(Xz) <- component_names

standardisation_parameters <- data.frame(
  component = component_names,
  mean = as.numeric(component_means),
  standard_deviation = as.numeric(component_sds)
)

readr::write_csv(
  standardisation_parameters,
  file.path(
    OUTPUT_DIR,
    "summary",
    "standardisation_parameters.csv"
  )
)


# =============================================================================
# 9. BAYESIAN ONE-FACTOR MODEL
# =============================================================================

# The model estimates a common latent resilience factor:
#
#   R[n] = lambda_R * eta[n] + error_R[n]
#   C[n] = lambda_C * eta[n] + error_C[n]
#   A[n] = lambda_A * eta[n] + error_A[n]
#
# eta[n] represents the latent resilience score for sampled pixel n.
# Positive loadings orient the factor toward higher component values.
#
# This model assumes that higher values of all three input components
# represent better ecological condition. Reverse-code any component
# whose direction represents degradation before running this script.

stan_code <- "
data {
  int<lower=1> N;
  matrix[N, 3] X;
}

parameters {
  vector[N] eta;
  vector<lower=0>[3] lambda;
  vector<lower=0>[3] sigma;
}

model {

  eta ~ normal(0, 1);

  lambda ~ normal(0, 1);
  sigma ~ normal(0, 1);

  for (n in 1:N) {

    X[n, 1] ~ normal(lambda[1] * eta[n], sigma[1]);

    X[n, 2] ~ normal(lambda[2] * eta[n], sigma[2]);

    X[n, 3] ~ normal(lambda[3] * eta[n], sigma[3]);

  }
}

generated quantities {

  vector[3] loading_share;

  loading_share = lambda / sum(lambda);

}
"

stan_file <- file.path(
  OUTPUT_DIR,
  "models",
  "Zulihe_Bayesian_LEREI_X.stan"
)

writeLines(
  stan_code,
  stan_file
)

stan_model <- cmdstanr::cmdstan_model(
  stan_file,
  quiet = TRUE
)

stan_data <- list(
  N = nrow(Xz),
  X = Xz
)

cat("\nFitting pooled Bayesian latent resilience model...\n")

fit <- stan_model$sample(
  data = stan_data,
  seed = RANDOM_STATE,
  chains = BAYESIAN_CHAINS,
  parallel_chains = BAYESIAN_CHAINS,
  iter_warmup = BAYESIAN_WARMUP,
  iter_sampling = BAYESIAN_DRAWS,
  adapt_delta = 0.95,
  refresh = 100,
  output_dir = file.path(OUTPUT_DIR, "traces")
)

saveRDS(
  fit,
  file.path(
    OUTPUT_DIR,
    "traces",
    "Zulihe_Bayesian_model.rds"
  )
)


# =============================================================================
# 10. EXTRACT POSTERIOR RESULTS
# =============================================================================

eta_draws <- posterior::as_draws_matrix(
  fit$draws(variables = "eta")
)

eta_mean <- colMeans(eta_draws)

if (length(eta_mean) != nrow(sample_df)) {
  stop("Posterior latent scores do not match the pooled sample rows.")
}

loading_draws <- posterior::as_draws_matrix(
  fit$draws(variables = "lambda")
)

loading_mean <- colMeans(loading_draws)

names(loading_mean) <- component_names

loading_shares <- loading_mean / sum(loading_mean)

names(loading_shares) <- component_names

posterior_results <- data.frame(
  component = component_names,
  loading = as.numeric(loading_mean),
  loading_share = as.numeric(loading_shares)
)

readr::write_csv(
  posterior_results,
  file.path(
    OUTPUT_DIR,
    "summary",
    "Bayesian_factor_loadings.csv"
  )
)

# Save posterior draws as a CSV file.
posterior_draws <- posterior::as_draws_df(
  fit$draws(
    variables = c("eta", "lambda", "sigma", "loading_share")
  )
)

readr::write_csv(
  posterior_draws,
  file.path(
    OUTPUT_DIR,
    "traces",
    "Zulihe_Bayesian_posterior_draws.csv"
  )
)

# Save parameter summaries.
posterior_summary <- fit$summary(
  variables = c("lambda", "sigma", "loading_share")
)

readr::write_csv(
  posterior_summary,
  file.path(
    OUTPUT_DIR,
    "summary",
    "Bayesian_parameter_summary.csv"
  )
)


# =============================================================================
# 11. BAYESIAN CONVERGENCE DIAGNOSTICS
# =============================================================================

diagnostics <- fit$summary(
  variables = c("lambda", "sigma")
)

max_rhat <- max(
  diagnostics$rhat,
  na.rm = TRUE
)

min_ess_bulk <- min(
  diagnostics$ess_bulk,
  na.rm = TRUE
)

min_ess_tail <- min(
  diagnostics$ess_tail,
  na.rm = TRUE
)

convergence_results <- data.frame(
  maximum_Rhat = max_rhat,
  minimum_ESS_bulk = min_ess_bulk,
  minimum_ESS_tail = min_ess_tail
)

readr::write_csv(
  convergence_results,
  file.path(
    OUTPUT_DIR,
    "summary",
    "Bayesian_convergence_diagnostics.csv"
  )
)

cat(
  "\nMaximum R-hat:", max_rhat,
  "\nMinimum bulk ESS:", min_ess_bulk,
  "\nMinimum tail ESS:", min_ess_tail,
  "\n"
)


# =============================================================================
# 12. LIGHTGBM SURROGATE MODEL
# =============================================================================

train_data <- lightgbm::lgb.Dataset(
  data = Xz,
  label = as.numeric(eta_mean),
  free_raw_data = FALSE
)

lgb_parameters <- list(
  objective = "regression",
  metric = "rmse",
  learning_rate = 0.05,
  num_leaves = 15,
  max_depth = -1,
  feature_fraction = 1.0,
  bagging_fraction = 1.0,
  verbosity = -1,
  seed = RANDOM_STATE,
  num_threads = 4
)

surrogate_model <- lightgbm::lgb.train(
  params = lgb_parameters,
  data = train_data,
  nrounds = 300,
  verbose = -1
)

train_predictions <- predict(
  surrogate_model,
  Xz
)

# Conventional predictive R-squared.
calculate_r2 <- function(observed, predicted) {

  denominator <- sum(
    (observed - mean(observed))^2
  )

  if (denominator <= 0) {
    return(NA_real_)
  }

  1 - sum(
    (observed - predicted)^2
  ) / denominator
}

calculate_rmse <- function(observed, predicted) {
  sqrt(mean((observed - predicted)^2))
}

train_r2 <- calculate_r2(
  eta_mean,
  train_predictions
)

train_rmse <- calculate_rmse(
  eta_mean,
  train_predictions
)

lightgbm::lgb.save(
  surrogate_model,
  file.path(
    OUTPUT_DIR,
    "models",
    "Zulihe_LEREI_X_LightGBM.txt"
  )
)

feature_importance <- lightgbm::lgb.importance(
