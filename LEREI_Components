)

readr::write_csv(
  feature_importance,
  file.path(
    OUTPUT_DIR,
    "summary",
    "LightGBM_feature_importance.csv"
  )
)


# =============================================================================
# 13. COMMON 0-1 SCALING
# =============================================================================

# One pooled scaling range is used for all three years.
# The range is based on the pooled posterior mean latent scores.

latent_min <- min(
  eta_mean,
  na.rm = TRUE
)

latent_max <- max(
  eta_mean,
  na.rm = TRUE
)

if (!is.finite(latent_min) ||
    !is.finite(latent_max) ||
    latent_max <= latent_min) {
  stop("The pooled latent scores cannot be scaled to 0-1.")
}

scale_lerei <- function(x) {

  scaled <- (x - latent_min) / (latent_max - latent_min)

  pmin(
    pmax(scaled, 0),
    1
  )
}


# =============================================================================
# 14. SPATIAL-BLOCK CROSS-VALIDATION
# =============================================================================

# Spatial blocks are constructed in projected map coordinates.
# Each grid block is assigned wholly to one fold.
# This evaluates prediction in held-out spatial blocks; it is not
# independent ecological validation of the LEREI-X indicators.

spatial_block_cv <- function(
    Xz,
    eta,
    coordinates,
    n_folds = 5,
    block_size = 5000,
    random_state = 42
) {

  if (nrow(coordinates) != nrow(Xz)) {
    stop("Coordinates and predictor rows do not match.")
  }

  block_x <- floor(
    (coordinates[, 1] - min(coordinates[, 1])) / block_size
  )

  block_y <- floor(
    (coordinates[, 2] - min(coordinates[, 2])) / block_size
  )

  block_id <- paste(
    block_x,
    block_y,
    sep = "_"
  )

  unique_blocks <- unique(block_id)

  if (length(unique_blocks) < n_folds) {
    stop(
      "There are fewer spatial blocks than CV folds. ",
      "Reduce the number of folds or adjust block size."
    )
  }

  set.seed(random_state)

  shuffled_blocks <- sample(unique_blocks)

  block_fold <- rep(
    seq_len(n_folds),
    length.out = length(shuffled_blocks)
  )

  names(block_fold) <- shuffled_blocks

  fold_id <- unname(
    block_fold[block_id]
  )

  results <- list()

  for (fold in seq_len(n_folds)) {

    test_index <- which(fold_id == fold)

    train_index <- which(fold_id != fold)

    if (
      length(test_index) < 20 ||
      length(train_index) < 50
    ) {
      next
    }

    fold_train <- lightgbm::lgb.Dataset(
      data = Xz[train_index, , drop = FALSE],
      label = as.numeric(eta[train_index])
    )

    fold_model <- lightgbm::lgb.train(
      params = lgb_parameters,
      data = fold_train,
      nrounds = 250,
      verbose = -1
    )

    predictions <- predict(
      fold_model,
      Xz[test_index, , drop = FALSE]
    )

    results[[as.character(fold)]] <- data.frame(
      fold = fold,
      n_train = length(train_index),
      n_test = length(test_index),
      cv_R2 = calculate_r2(
        eta[test_index],
        predictions
      ),
      cv_RMSE = calculate_rmse(
        eta[test_index],
        predictions
      )
    )
  }

  if (length(results) == 0) {
    stop(
      "No valid spatial CV folds were produced. ",
      "Review the sample distribution and block size."
    )
  }

  dplyr::bind_rows(results)
}

coordinates <- as.matrix(
  sample_df[, c("x", "y")]
)

cat("\nRunning spatial-block cross-validation...\n")

cv_results <- spatial_block_cv(
  Xz = Xz,
  eta = eta_mean,
  coordinates = coordinates,
  n_folds = N_CV_FOLDS,
  block_size = SPATIAL_BLOCK_SIZE_M,
  random_state = RANDOM_STATE
)

readr::write_csv(
  cv_results,
  file.path(
    OUTPUT_DIR,
    "summary",
    "spatial_block_CV_results.csv"
  )
)

cv_r2 <- mean(
  cv_results$cv_R2,
  na.rm = TRUE
)

cv_rmse <- mean(
  cv_results$cv_RMSE,
  na.rm = TRUE
)


# =============================================================================
# 15. ANNUAL LEREI-X RASTER GENERATION
# =============================================================================

generate_lerei_raster <- function(
    input_raster,
    year,
    output_path,
    model,
    component_means,
    component_sds
) {

  r <- terra::rast(input_raster)

  if (terra::nlyr(r) != 3) {
    stop("Expected three component bands for year ", year)
  }

  names(r) <- c("R", "C", "A")

  # terra::app supplies a matrix:
  # rows = raster cells; columns = R, C, and A.

  prediction_function <- function(v) {

    v <- as.matrix(v)

    output <- rep(
      NA_real_,
      nrow(v)
    )

    valid <- complete.cases(v) &
      apply(
        v,
        1,
        function(z) all(is.finite(z))
      )

    if (any(valid)) {

      X_new <- v[
        valid,
        1:3,
        drop = FALSE
      ]

      X_new_z <- sweep(
        X_new,
        2,
        component_means,
        "-"
      )

      X_new_z <- sweep(
        X_new_z,
        2,
        component_sds,
        "/"
      )

      predictions <- predict(
        model,
        X_new_z
      )

      output[valid] <- scale_lerei(
        predictions
      )
    }

    output
  }

  terra::app(
    r,
    fun = prediction_function,
    filename = output_path,
    overwrite = TRUE,
    wopt = list(
      datatype = "FLT4S",
      gdal = c(
        "COMPRESS=LZW",
        "TILED=YES"
      )
    )
  )

  cat(
    "\nGenerated annual LEREI-X raster:",
    year,
    "\n"
  )

  output_path
}


